---
interface Props {
	date: Date;
}

const { date } = Astro.props;

const MONTHS = [
	'Ene',
	'Feb',
	'Mar',
	'Abr',
	'May',
	'Jun',
	'Jul',
	'Ago',
	'Sep',
	'Oct',
	'Nov',
	'Dic',
];

const day = String(date.getDate()).padStart(2, '0');
const month = MONTHS[date.getMonth()];
---

<time datetime={date.toISOString()}>{`${day} ${month}`}</time>
