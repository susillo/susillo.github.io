			<a href={import.meta.env.BASE_URL + 'rss.xml'} class="social" aria-label="RSS">
				<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		box-sizing: border-box;
		width: 100%;
		max-width: var(--frame);
		margin: 0 auto;
		padding: 0 var(--pad-x) var(--pad-y);
	}
	.footer-content {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.find {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted-2);
	}
	.social-links {
		display: flex;
		gap: 16px;
	}
	.social {
		width: 36px;
		height: 36px;
		background: var(--ink-2);
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--muted);
	}
	.social:hover {
		color: var(--lime);
		text-decoration: none;
	}
</style>
