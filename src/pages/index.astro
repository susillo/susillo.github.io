---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);
const BASE_URL = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="mono">
		<Header />
		<main>
			<section class="hero">
				<p class="hero-kicker">DE LOS PÍXELES A LA IA...</p>
				<h1 class="hero-title">Aprovechar cada cambio para llegar un poco más lejos.</h1>
				<p class="hero-lede">
					mis notas y pensamientos sobre tecnología, ciberseguridad y salud; de cómo intento aprender de cada oportunidad que se me presenta cada día para sacarle el máximo partido y seguir adaptándome.
				</p>
			</section>

			<section class="posts">
				<ul class="post-list">
					{
						posts.map((post) => (
							<li class="post-item">
								<a href={`${BASE_URL}${post.id}/`} class="post-link">
									<span class="post-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<div class="post-content">
										<h2 class="post-title">{post.data.title}</h2>
										<p class="post-desc">{post.data.description}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: var(--section-gap);
	}
	.hero {
		display: flex;
		flex-direction: column;
		gap: 18px;
	}
	.hero-kicker {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.25em;
		color: var(--teal);
	}
	.hero-title {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 52px;
		font-weight: 800;
		line-height: 1.08;
		color: var(--paper);
	}
	.hero-lede {
		margin: 0;
		font-family: var(--font-sans);
		font-size: 16px;
		line-height: 1.5;
		color: var(--muted);
	}

	@media (max-width: 700px) {
		.hero-title {
			font-size: 34px;
		}
	}
</style>
