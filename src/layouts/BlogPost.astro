---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

type Neighbour = { id: string; title: string };

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: number;
	prev?: Neighbour;
	next?: Neighbour;
};

const { title, description, pubDate, tags = [], heroImage, readingTime, prev, next } = Astro.props;
const BASE_URL = import.meta.env.BASE_URL;

const MONTHS = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
const dateLabel = `${String(pubDate.getDate()).padStart(2, '0')} ${MONTHS[pubDate.getMonth()]} ${pubDate.getFullYear()}`;
---

<html lang="es">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body class="mono">
		<Header />
		<main class="article">
			<a class="back" href={`${BASE_URL}archivo/`}>
				<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg>
				<span>todas las notas</span>
			</a>

			<header class="head">
				<h1 class="page-title">{title}</h1>
				<div class="page-meta">
					<span class="date">{dateLabel}</span>
					{
						readingTime !== undefined && (
							<>
								<span class="dot"></span>
								<span class="read">{readingTime} min de lectura</span>
							</>
						)
					}
					{tags[0] && <><span class="dot"></span><span class="tag">{`#${tags[0]}`}</span></>}
				</div>
			</header>

			<div class="prose">
				<slot />
			</div>

			{
				readingTime !== undefined && (
					<footer class="endmatter">
						<hr />
						{tags.length > 0 && (
							<div class="tags">
								{tags.map((tag) => (
									<span class="pill">{`#${tag}`}</span>
								))}
							</div>
						)}
						<div class="prev-next">
							{prev ? (
								<a class="prev" href={`${BASE_URL}${prev.id}/`}>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
									<span>{prev.title}</span>
								</a>
							) : (
								<span></span>
							)}
							{next ? (
								<a class="next" href={`${BASE_URL}${next.id}/`}>
									<span>{next.title}</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
								</a>
							) : (
								<a class="next" href={`${BASE_URL}archivo/`}>
									<span>todas las notas</span>
									<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
								</a>
							)}
						</div>
					</footer>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		display: flex;
		flex-direction: column;
		gap: 26px;
	}
	.back {
		display: flex;
		align-items: center;
		gap: 8px;
		width: fit-content;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
		text-decoration: none;
	}
	.back:hover {
		color: var(--lime);
		text-decoration: none;
	}
	.head {
		display: flex;
		flex-direction: column;
		gap: 14px;
		width: 100%;
		max-width: 880px;
	}
	.prose {
		width: 100%;
		max-width: 880px;
	}
	.endmatter {
		display: flex;
		flex-direction: column;
		gap: 20px;
		width: 100%;
		max-width: 880px;
	}
	.endmatter hr {
		width: 100%;
		margin: 0;
		border: 0;
		border-top: 1px solid var(--line);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}
	.pill {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		padding: 6px 12px;
		border-radius: 8px;
		background: var(--ink-2);
		border: 1px solid var(--line);
		color: var(--muted);
	}
	.pill:first-child {
		background: var(--lime);
		border-color: var(--lime);
		color: var(--ink);
	}
	.prev-next {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 20px;
		font-family: var(--font-mono);
		font-size: 13px;
	}
	.prev,
	.next {
		display: flex;
		align-items: center;
		gap: 8px;
		max-width: 48%;
		text-decoration: none;
	}
	.prev {
		color: var(--lime);
	}
	.next {
		color: var(--muted);
	}
	.prev:hover,
	.next:hover {
		text-decoration: underline;
	}
	.prev span,
	.next span {
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	@media (max-width: 700px) {
		.prev-next {
			flex-direction: column;
			align-items: flex-start;
		}
		.prev,
		.next {
			max-width: 100%;
		}
	}
</style>
